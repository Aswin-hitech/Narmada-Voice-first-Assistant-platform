# ==============================================================================
# NARMADA - NVIDIA AI Foundation Models Configuration (Template)
# ==============================================================================

# 1. Speech-to-Text (NVIDIA Parakeet ASR)
PARAKEET_API_KEY=nvapi-your-parakeet-key
PARAKEET_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v2
PARAKEET_ASR_SERVER=grpc.nvcf.nvidia.com:443
# PARAKEET_FUNCTION_ID=

# 2. Reasoning & Generating (NVIDIA Nemotron-3 Super 120B)
NEMOTRON_API_KEY=nvapi-your-nemotron-key
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# 3. Text Translation (NVIDIA Riva-Translate-4B-Instruct-v2)
RIVA_TRANSLATE_API_KEY=nvapi-your-riva-translate-key
RIVA_TRANSLATE_BASE_URL=https://integrate.api.nvidia.com/v1
RIVA_TRANSLATE_MODEL=nvidia/riva-translate-4b-instruct-v2

# Global Fallback API Key (used if any individual model key is omitted)
NVIDIA_API_KEY=nvapi-your-global-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Database URL (Optional PostgreSQL, defaults to SQLite if empty)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require